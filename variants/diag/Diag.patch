diff --git a/MdeModulePkg/Core/Dxe/Image/Image.c b/MdeModulePkg/Core/Dxe/Image/Image.c
index eb2ce42..d1f480a 100644
--- a/MdeModulePkg/Core/Dxe/Image/Image.c
+++ b/MdeModulePkg/Core/Dxe/Image/Image.c
@@ -1619,6 +1619,240 @@ CoreLoadImage (
   return Status;
 }
 
+#if defined (MDE_CPU_AARCH64)
+STATIC EFI_STALL                    mDgStall;
+STATIC EFI_GET_TIME                 mDgGetTime;
+STATIC EFI_SET_WATCHDOG_TIMER       mDgWatchdog;
+STATIC EFI_GET_NEXT_MONOTONIC_COUNT mDgMono;
+STATIC UINT64                       mDgCnt[4];
+STATIC BOOLEAN                      mDgBusy;
+STATIC BOOLEAN                      mDgInstalled;
+
+STATIC
+BOOLEAN
+DgLog (
+  IN UINTN  Index
+  )
+{
+  mDgCnt[Index]++;
+  if (mDgBusy) {
+    return FALSE;
+  }
+
+  return (BOOLEAN)((mDgCnt[Index] <= 20) || ((mDgCnt[Index] % 20000) == 0));
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+DgStall (
+  IN UINTN  Microseconds
+  )
+{
+  if (DgLog (0)) {
+    mDgBusy = TRUE;
+    DEBUG ((DEBUG_ERROR, "DG Stall(%lu) #%lu\n", (UINT64)Microseconds, mDgCnt[0]));
+    mDgBusy = FALSE;
+  }
+
+  return mDgStall (Microseconds);
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+DgGetTime (
+  OUT EFI_TIME               *Time,
+  OUT EFI_TIME_CAPABILITIES  *Capabilities OPTIONAL
+  )
+{
+  EFI_STATUS  Status;
+
+  Status = mDgGetTime (Time, Capabilities);
+  if (DgLog (1)) {
+    mDgBusy = TRUE;
+    DEBUG ((DEBUG_ERROR, "DG GetTime #%lu -> %r %u-%u-%u %u:%u:%u\n", mDgCnt[1], Status, (UINT32)Time->Year, (UINT32)Time->Month, (UINT32)Time->Day, (UINT32)Time->Hour, (UINT32)Time->Minute, (UINT32)Time->Second));
+    mDgBusy = FALSE;
+  }
+
+  return Status;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+DgWatchdog (
+  IN UINTN   Timeout,
+  IN UINT64  WatchdogCode,
+  IN UINTN   DataSize,
+  IN CHAR16  *WatchdogData OPTIONAL
+  )
+{
+  if (DgLog (2)) {
+    mDgBusy = TRUE;
+    DEBUG ((DEBUG_ERROR, "DG SetWatchdogTimer(%lu) #%lu\n", (UINT64)Timeout, mDgCnt[2]));
+    mDgBusy = FALSE;
+  }
+
+  return mDgWatchdog (Timeout, WatchdogCode, DataSize, WatchdogData);
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+DgMono (
+  OUT UINT64  *Count
+  )
+{
+  if (DgLog (3)) {
+    mDgBusy = TRUE;
+    DEBUG ((DEBUG_ERROR, "DG GetNextMonotonicCount #%lu\n", mDgCnt[3]));
+    mDgBusy = FALSE;
+  }
+
+  return mDgMono (Count);
+}
+
+STATIC
+VOID
+DgDump (
+  VOID
+  )
+{
+  UINT64  El, Daif, Sctlr, Vbar, Frq, Kctl, PCtl, PCval, PCt, Pmr, Grp1, Sre, Tcr, Mair;
+  UINT32  Dctl, Rwake, Ren, Rpend, Ract, Rprio7;
+
+  __asm__ volatile ("mrs %0, CurrentEL" : "=r" (El));
+  El >>= 2;
+  __asm__ volatile ("mrs %0, DAIF" : "=r" (Daif));
+  if (El == 2) {
+    __asm__ volatile ("mrs %0, sctlr_el2" : "=r" (Sctlr));
+    __asm__ volatile ("mrs %0, vbar_el2" : "=r" (Vbar));
+    __asm__ volatile ("mrs %0, tcr_el2" : "=r" (Tcr));
+    __asm__ volatile ("mrs %0, mair_el2" : "=r" (Mair));
+  } else {
+    __asm__ volatile ("mrs %0, sctlr_el1" : "=r" (Sctlr));
+    __asm__ volatile ("mrs %0, vbar_el1" : "=r" (Vbar));
+    __asm__ volatile ("mrs %0, tcr_el1" : "=r" (Tcr));
+    __asm__ volatile ("mrs %0, mair_el1" : "=r" (Mair));
+  }
+
+  __asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (Frq));
+  __asm__ volatile ("mrs %0, cntp_ctl_el0" : "=r" (PCtl));
+  __asm__ volatile ("mrs %0, cntp_cval_el0" : "=r" (PCval));
+  __asm__ volatile ("mrs %0, cntpct_el0" : "=r" (PCt));
+  Kctl = 0;
+  if (El == 1) {
+    __asm__ volatile ("mrs %0, cntkctl_el1" : "=r" (Kctl));
+  }
+
+  __asm__ volatile ("mrs %0, S3_0_C4_C6_0" : "=r" (Pmr));
+  __asm__ volatile ("mrs %0, S3_0_C12_C12_7" : "=r" (Grp1));
+  __asm__ volatile ("mrs %0, S3_0_C12_C12_5" : "=r" (Sre));
+
+  Dctl    = (*(volatile UINT32 *)(UINTN)(0x0F200000));
+  Rwake   = (*(volatile UINT32 *)(UINTN)(0x0F300014));
+  Ren     = (*(volatile UINT32 *)(UINTN)(0x0F310100));
+  Rpend   = (*(volatile UINT32 *)(UINTN)(0x0F310200));
+  Ract    = (*(volatile UINT32 *)(UINTN)(0x0F310300));
+  Rprio7  = (*(volatile UINT32 *)(UINTN)(0x0F310400 + 28));
+
+  DEBUG ((DEBUG_ERROR, "DG state EL=%lu DAIF=%lx SCTLR=%lx VBAR=%lx TCR=%lx MAIR=%lx\n", El, Daif, Sctlr, Vbar, Tcr, Mair));
+  DEBUG ((DEBUG_ERROR, "DG timer CNTFRQ=%lu CNTKCTL=%lx CNTP_CTL=%lx CNTP_CVAL=%lx CNTPCT=%lx\n", Frq, Kctl, PCtl, PCval, PCt));
+  DEBUG ((DEBUG_ERROR, "DG gic ICC_PMR=%lx IGRPEN1=%lx SRE=%lx GICD_CTLR=%x GICR_WAKER=%x ISEN0=%x ISPEND0=%x ISACT0=%x PRIO30=%x\n", Pmr, Grp1, Sre, Dctl, Rwake, Ren, Rpend, Ract, Rprio7));
+
+  //
+  // Prueba del contador de ciclos del PMU, igual que lo configura bootmgr (PMCCNTR_EL0).
+  //
+  {
+    UINT64  Pmcr, T0, A, B, Tn;
+
+    DEBUG ((DEBUG_ERROR, "DG pmu: leyendo PMCR_EL0\n"));
+    __asm__ volatile ("mrs %0, PMCR_EL0" : "=r" (Pmcr));
+    DEBUG ((DEBUG_ERROR, "DG pmu: PMCR_EL0=%lx (N=%lu E=%lu)\n", Pmcr, (Pmcr >> 11) & 0x1F, Pmcr & 1));
+    Tn = Pmcr | 0x10;
+    if ((Tn & 1) == 0) {
+      Tn |= 5;
+      __asm__ volatile ("msr PMCNTENCLR_EL0, %0; isb" : : "r" (0xFFFFFFFFULL));
+      __asm__ volatile ("msr PMOVSCLR_EL0, %0; isb" : : "r" (0xFFFFFFFFULL));
+      __asm__ volatile ("msr PMINTENCLR_EL1, %0; isb" : : "r" (0xFFFFFFFFULL));
+    }
+
+    Tn &= ~0x20ULL;
+    DEBUG ((DEBUG_ERROR, "DG pmu: escribiendo PMCR_EL0=%lx\n", Tn));
+    __asm__ volatile ("msr PMCR_EL0, %0; isb" : : "r" (Tn));
+    __asm__ volatile ("msr PMCCFILTR_EL0, %0; isb" : : "r" (0x08000000ULL));
+    __asm__ volatile ("msr PMCNTENSET_EL0, %0; isb" : : "r" (0x80000000ULL));
+    __asm__ volatile ("msr PMUSERENR_EL0, %0; isb" : : "r" (0ULL));
+    __asm__ volatile ("mrs %0, PMCCNTR_EL0" : "=r" (A));
+    __asm__ volatile ("mrs %0, CNTPCT_EL0" : "=r" (T0));
+    do {
+      __asm__ volatile ("mrs %0, CNTPCT_EL0" : "=r" (Tn));
+    } while ((Tn - T0) < (Frq / 100));
+
+    __asm__ volatile ("mrs %0, PMCCNTR_EL0" : "=r" (B));
+    __asm__ volatile ("mrs %0, PMCR_EL0" : "=r" (Pmcr));
+    DEBUG ((DEBUG_ERROR, "DG pmu: PMCCNTR antes=%lx despues(10ms)=%lx delta=%lu PMCR=%lx\n", A, B, B - A, Pmcr));
+  }
+
+  //
+  // Prueba de la memoria donde bootmgr reserva su bloque fijo (0x45D20000 - 0x45DFFFFF):
+  // contenido previo, escritura/lectura y accesos exclusivos (ldxr/stxr), frente a una variable local.
+  //
+  {
+    STATIC CONST UINT64  DgAddr[3] = { 0x45D20000ULL, 0x45D60000ULL, 0x45DFFFF0ULL };
+    volatile UINT64      Local     = 0;
+    UINTN                Idx, Try;
+    UINT64               Old, Tmp, Rd;
+    UINT32               St;
+
+    for (Idx = 0; Idx < 4; Idx++) {
+      volatile UINT64  *P = (Idx < 3) ? (volatile UINT64 *)(UINTN)DgAddr[Idx] : &Local;
+
+      DEBUG ((DEBUG_ERROR, "DG mem[%lu] %lx: leyendo\n", (UINT64)Idx, (UINT64)(UINTN)P));
+      Old = P[0];
+      DEBUG ((DEBUG_ERROR, "DG mem[%lu] previo=%lx\n", (UINT64)Idx, Old));
+      P[0] = 0x1122334455667788ULL;
+      __asm__ volatile ("dsb sy; dc civac, %0; dsb sy" : : "r" (P) : "memory");
+      Rd = P[0];
+      for (Try = 0; Try < 1000; Try++) {
+        __asm__ volatile (
+          "ldxr %0, [%2]\n"
+          "add  %0, %0, #1\n"
+          "stxr %w1, %0, [%2]\n"
+          : "=&r" (Tmp), "=&r" (St) : "r" (P) : "memory"
+          );
+        if (St == 0) {
+          break;
+        }
+      }
+
+      __asm__ volatile ("dsb sy; dc civac, %0; dsb sy" : : "r" (P) : "memory");
+      DEBUG ((DEBUG_ERROR, "DG mem[%lu] rw=%lx excl: intentos=%lu st=%u final=%lx\n", (UINT64)Idx, Rd, (UINT64)Try, St, P[0]));
+      P[0] = Old;
+      __asm__ volatile ("dsb sy; dc civac, %0; dsb sy" : : "r" (P) : "memory");
+    }
+  }
+
+  if (!mDgInstalled) {
+    mDgInstalled         = TRUE;
+    mDgStall             = gBS->Stall;
+    mDgGetTime           = gDxeCoreRT->GetTime;
+    mDgWatchdog          = gBS->SetWatchdogTimer;
+    mDgMono              = gBS->GetNextMonotonicCount;
+    gBS->Stall                    = DgStall;
+    gBS->SetWatchdogTimer         = DgWatchdog;
+    gBS->GetNextMonotonicCount    = DgMono;
+    gDxeCoreRT->GetTime           = DgGetTime;
+    gBS->Hdr.CRC32 = 0;
+    gBS->CalculateCrc32 (gBS, gBS->Hdr.HeaderSize, &gBS->Hdr.CRC32);
+    gDxeCoreRT->Hdr.CRC32 = 0;
+    gBS->CalculateCrc32 (gDxeCoreRT, gDxeCoreRT->Hdr.HeaderSize, &gDxeCoreRT->Hdr.CRC32);
+  }
+}
+#endif
+
+
 /**
   Transfer control to a loaded image's entry point.
 
@@ -1742,6 +1976,12 @@ CoreStartImage (
     // Call the image's entry point
     //
     Image->Started = TRUE;
+#if defined (MDE_CPU_AARCH64)
+    if (Image->ImageContext.ImageType == EFI_IMAGE_SUBSYSTEM_EFI_APPLICATION) {
+      DgDump ();
+    }
+
+#endif
     Image->Status  = Image->EntryPoint (ImageHandle, Image->Info.SystemTable);
 
     //
