+STATIC EFI_BLOCK_READ     mDgRealRead;
+STATIC UINT8              *mDgHkPrim;
+STATIC UINT8              *mDgHkBack;
+STATIC UINT64             mDgHkLast;
+STATIC UINTN              mDgHkNP;
+STATIC UINTN              mDgHkNB;
+
+//
+// Envoltorio de ReadBlocks del disco: los sectores de la GPT (LBA 1..NP y los ultimos NB) se sirven desde la copia buena.
+//
+STATIC
+EFI_STATUS
+EFIAPI
+DgBioRead (
+  IN  EFI_BLOCK_IO_PROTOCOL  *This,
+  IN  UINT32                 MediaId,
+  IN  EFI_LBA                Lba,
+  IN  UINTN                  BufferSize,
+  OUT VOID                   *Buffer
+  )
+{
+  EFI_STATUS  St;
+  UINT64      N, S0, S1, A, B, BackStart;
+
+  St = mDgRealRead (This, MediaId, Lba, BufferSize, Buffer);
+  if (EFI_ERROR (St) || ((BufferSize % 512) != 0)) {
+    return St;
+  }
+
+  N = BufferSize / 512;
+  S0 = Lba;
+  S1 = Lba + N;
+  A  = (S0 > 1) ? S0 : 1;
+  B  = (S1 < (1 + mDgHkNP)) ? S1 : (1 + mDgHkNP);
+  if (A < B) {
+    CopyMem ((UINT8 *)Buffer + (A - S0) * 512, mDgHkPrim + (A - 1) * 512, (UINTN)(B - A) * 512);
+  }
+
+  BackStart = mDgHkLast - (mDgHkNB - 1);
+  A         = (S0 > BackStart) ? S0 : BackStart;
+  B         = (S1 < (mDgHkLast + 1)) ? S1 : (mDgHkLast + 1);
+  if (A < B) {
+    CopyMem ((UINT8 *)Buffer + (A - S0) * 512, mDgHkBack + (A - BackStart) * 512, (UINTN)(B - A) * 512);
+  }
+
+  return St;
+}
+
+STATIC
+BOOLEAN
+DgGptHdrOk (
+  IN CONST UINT8  *Sec,
+  IN UINT64       MyLba,
+  IN CONST UINT8  *Entries,
+  IN UINTN        EntriesAvail
+  )
+{
+  UINT8   Tmp[92];
+  UINT32  Crc, Want, HSize, NEnt, ESize;
+  UINT64  My;
+
+  if (CompareMem (Sec, "EFI PART", 8) != 0) {
+    return FALSE;
+  }
+
+  CopyMem (&HSize, Sec + 12, 4);
+  if (HSize != 92) {
+    return FALSE;
+  }
+
+  CopyMem (&Want, Sec + 16, 4);
+  CopyMem (Tmp, Sec, 92);
+  ZeroMem (Tmp + 16, 4);
+  Crc = 0;
+  if (EFI_ERROR (gBS->CalculateCrc32 (Tmp, 92, &Crc)) || (Crc != Want)) {
+    return FALSE;
+  }
+
+  CopyMem (&My, Sec + 24, 8);
+  if (My != MyLba) {
+    return FALSE;
+  }
+
+  CopyMem (&NEnt, Sec + 80, 4);
+  CopyMem (&ESize, Sec + 84, 4);
+  if ((ESize != 128) || (NEnt == 0) || (((UINTN)NEnt * ESize) > EntriesAvail)) {
+    return FALSE;
+  }
+
+  CopyMem (&Want, Sec + 88, 4);
+  Crc = 0;
+  if (EFI_ERROR (gBS->CalculateCrc32 ((VOID *)Entries, (UINTN)NEnt * ESize, &Crc)) || (Crc != Want)) {
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+//
+// Si la GPT del disco no es la que guardo el PC en 67 sectores libres del final del disco, la restaura y reinicia.
+// (El recovery revierte la GPT al reiniciar; asi Windows siempre ve sus particiones.)
+// Copia guardada: sector 0 = cabecera "T500GPT1", luego LBA 1..33 (primaria) y los ultimos 33 sectores (respaldo).
+//
+STATIC
+VOID
+DgGptRestore (
+  VOID
+  )
+{
+  STATIC BOOLEAN   Done    = FALSE;
+  STATIC EFI_GUID  BioGuid = { 0x964E5B21, 0x6459, 0x11D2, { 0x8E, 0x39, 0x00, 0xA0, 0xC9, 0x69, 0x72, 0x3B } };
+  CONST UINT64     BlobLba = 122140680ULL;
+  CONST UINTN      NP      = 33;
+  CONST UINTN      NB      = 33;
+  EFI_HANDLE       *Hb, DiskH;
+  UINTN            Hn, Hi, Off;
+  EFI_BLOCK_IO_PROTOCOL  *Bio, *Dk;
+  UINT8            *Blob, *Cur, *Prim, *Back;
+  UINT64           Last, EL, EntLba, CurAlt;
+  UINT32           Mid, Ver, Np, Nb, Tries;
+  EFI_STATUS       St;
+  BOOLEAN          Same;
+
+  if (Done) {
+    return;
+  }
+
+  Done = TRUE;
+  Hb   = NULL;
+  Hn   = 0;
+  Dk    = NULL;
+  DiskH = NULL;
+  if (EFI_ERROR (gBS->LocateHandleBuffer (ByProtocol, &BioGuid, NULL, &Hn, &Hb))) {
+    return;
+  }
+
+  for (Hi = 0; Hi < Hn; Hi++) {
+    if (!EFI_ERROR (gBS->HandleProtocol (Hb[Hi], &BioGuid, (VOID **)&Bio)) && (Bio->Media != NULL) &&
+        Bio->Media->MediaPresent && !Bio->Media->LogicalPartition && (Bio->Media->BlockSize == 512) &&
+        (Bio->Media->LastBlock >= 100000000ULL))
+    {
+      Dk    = Bio;
+      DiskH = Hb[Hi];
+      break;
+    }
+  }
+
+  if (Dk == NULL) {
+    DEBUG ((DEBUG_ERROR, "DG gpt: no encuentro el disco\n"));
+    return;
+  }
+
+  Last = Dk->Media->LastBlock;
+  Mid  = Dk->Media->MediaId;
+  if (Last < (BlobLba + 1 + NP + NB)) {
+    return;
+  }
+
+  Blob = NULL;
+  Cur  = NULL;
+  if (EFI_ERROR (gBS->AllocatePool (EfiBootServicesData, 512 * (1 + NP + NB), (VOID **)&Blob)) ||
+      EFI_ERROR (gBS->AllocatePool (EfiBootServicesData, 512 * NP, (VOID **)&Cur)))
+  {
+    return;
+  }
+
+  St = Dk->ReadBlocks (Dk, Mid, BlobLba, 512 * (1 + NP + NB), Blob);
+  if (EFI_ERROR (St)) {
+    DEBUG ((DEBUG_ERROR, "DG gpt: no pude leer la copia guardada (%r)\n", St));
+    return;
+  }
+
+  if (CompareMem (Blob, "T500GPT1", 8) != 0) {
+    DEBUG ((DEBUG_ERROR, "DG gpt: no hay copia guardada\n"));
+    return;
+  }
+
+  CopyMem (&Ver, Blob + 8, 4);
+  CopyMem (&Np, Blob + 12, 4);
+  CopyMem (&Nb, Blob + 16, 4);
+  CopyMem (&Tries, Blob + 20, 4);
+  CopyMem (&EL, Blob + 24, 8);
+  if ((Ver != 1) || (Np != NP) || (Nb != NB) || (EL != Last)) {
+    DEBUG ((DEBUG_ERROR, "DG gpt: copia guardada no valida (ver=%u np=%u nb=%u)\n", Ver, Np, Nb));
+    return;
+  }
+
+  Prim = Blob + 512;
+  Back = Prim + 512 * NP;
+  St   = Dk->ReadBlocks (Dk, Mid, 1, 512 * NP, Cur);
+  if (EFI_ERROR (St)) {
+    DEBUG ((DEBUG_ERROR, "DG gpt: no pude leer la GPT actual (%r)\n", St));
+    return;
+  }
+
+  if (CompareMem (Cur, Prim, 512 * NP) == 0) {
+    DEBUG ((DEBUG_ERROR, "DG gpt: la GPT del disco es la guardada; nada que restaurar\n"));
+    return;
+  }
+
+  CopyMem (&CurAlt, Cur + 32, 8);
+  if ((CompareMem (Cur, "EFI PART", 8) != 0) || (CurAlt != Last)) {
+    DEBUG ((DEBUG_ERROR, "DG gpt: la GPT actual no se parece a la de este disco; no toco nada\n"));
+    return;
+  }
+
+  if (!DgGptHdrOk (Prim, 1, Prim + 512, 512 * (NP - 1))) {
+    DEBUG ((DEBUG_ERROR, "DG gpt: la copia primaria guardada no es valida\n"));
+    return;
+  }
+
+  CopyMem (&EntLba, Back + 512 * (NB - 1) + 72, 8);
+  if ((EntLba < (Last - (NB - 1))) || (EntLba >= Last)) {
+    DEBUG ((DEBUG_ERROR, "DG gpt: la copia de respaldo guardada no es valida (entradas en %lx)\n", EntLba));
+    return;
+  }
+
+  Off = (UINTN)(EntLba - (Last - (NB - 1))) * 512;
+  if (!DgGptHdrOk (Back + 512 * (NB - 1), Last, Back + Off, 512 * (NB - 1) - Off)) {
+    DEBUG ((DEBUG_ERROR, "DG gpt: la copia de respaldo guardada no es valida\n"));
+    return;
+  }
+
+  DEBUG ((DEBUG_ERROR, "DG gpt: la GPT del disco NO es la guardada. La restauro (sin reiniciar)...\n"));
+  DEBUG ((DEBUG_ERROR, "DG gpt: medio ReadOnly=%u WriteCaching=%u MediaId=%u ultimo=%lx\n", (UINT32)Dk->Media->ReadOnly, (UINT32)Dk->Media->WriteCaching, Mid, Last));
+  St = Dk->WriteBlocks (Dk, Mid, 1, 512 * NP, Prim);
+  DEBUG ((DEBUG_ERROR, "DG gpt: primaria -> %r\n", St));
+  if (!EFI_ERROR (St)) {
+    St = Dk->WriteBlocks (Dk, Mid, Last - (NB - 1), 512 * NB, Back);
+    DEBUG ((DEBUG_ERROR, "DG gpt: respaldo -> %r\n", St));
+  }
+
+  Dk->FlushBlocks (Dk);
+  ZeroMem (Cur, 512 * NP);
+  St = Dk->ReadBlocks (Dk, Mid, 1, 512 * NP, Cur);
+  Same = (BOOLEAN)(!EFI_ERROR (St) && (CompareMem (Cur, Prim, 512 * NP) == 0));
+  DEBUG ((DEBUG_ERROR, "DG gpt: releida tras escribir: %a\n", Same ? "IGUAL a lo escrito (la escritura funciona)" : "DISTINTA (la escritura NO tiene efecto)"));
+  if (!Same) {
+    mDgRealRead = Dk->ReadBlocks;
+    mDgHkPrim   = Prim;
+    mDgHkBack   = Back;
+    mDgHkLast   = Last;
+    mDgHkNP     = NP;
+    mDgHkNB     = NB;
+    Dk->ReadBlocks = DgBioRead;
+    DEBUG ((DEBUG_ERROR, "DG gpt: instalo lectura virtual de la GPT buena (solo en RAM, solo este arranque)\n"));
+  }
+
+  //
+  // Releer las particiones: se sueltan todos los controladores del disco (borra los hijos = particiones viejas)
+  // y se vuelven a conectar (el controlador de particiones lee la GPT).
+  //
+  St = gBS->DisconnectController (DiskH, NULL, NULL);
+  DEBUG ((DEBUG_ERROR, "DG gpt: desconectar disco -> %r\n", St));
+  St = gBS->ConnectController (DiskH, NULL, NULL, TRUE);
+  DEBUG ((DEBUG_ERROR, "DG gpt: reconectar disco -> %r\n", St));
+}
+
+STATIC
+VOID
+DgDump (
+  VOID
+  )
+{
+  UINT64  El, Daif, Sctlr, Vbar, Frq, Kctl, PCtl, PCval, PCt, Pmr, Grp1, Sre, Tcr, Mair;
+  UINT32  Dctl, Rwake, Ren, Rpend, Ract, Rprio7;
+
+  DgGptRestore ();
+
+  __asm__ volatile ("mrs %0, CurrentEL" : "=r" (El));
+  El >>= 2;
+  __asm__ volatile ("mrs %0, DAIF" : "=r" (Daif));
+  if (El == 2) {
+    __asm__ volatile ("mrs %0, sctlr_el2" : "=r" (Sctlr));
+    __asm__ volatile ("mrs %0, vbar_el2" : "=r" (Vbar));
+    __asm__ volatile ("mrs %0, tcr_el2" : "=r" (Tcr));
+    __asm__ volatile ("mrs %0, mair_el2" : "=r" (Mair));
+  } else {
+    __asm__ volatile ("mrs %0, sctlr_el1" : "=r" (Sctlr));
+    __asm__ volatile ("mrs %0, vbar_el1" : "=r" (Vbar));
+    __asm__ volatile ("mrs %0, tcr_el1" : "=r" (Tcr));
+    __asm__ volatile ("mrs %0, mair_el1" : "=r" (Mair));
+  }
+
+  __asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (Frq));
+  __asm__ volatile ("mrs %0, cntp_ctl_el0" : "=r" (PCtl));
+  __asm__ volatile ("mrs %0, cntp_cval_el0" : "=r" (PCval));
+  __asm__ volatile ("mrs %0, cntpct_el0" : "=r" (PCt));
+  Kctl = 0;
+  if (El == 1) {
+    __asm__ volatile ("mrs %0, cntkctl_el1" : "=r" (Kctl));
+  }
+
+  __asm__ volatile ("mrs %0, S3_0_C4_C6_0" : "=r" (Pmr));
+  __asm__ volatile ("mrs %0, S3_0_C12_C12_7" : "=r" (Grp1));
+  __asm__ volatile ("mrs %0, S3_0_C12_C12_5" : "=r" (Sre));
+
+  Dctl    = (*(volatile UINT32 *)(UINTN)(0x0F200000));
+  Rwake   = (*(volatile UINT32 *)(UINTN)(0x0F300014));
+  Ren     = (*(volatile UINT32 *)(UINTN)(0x0F310100));
+  Rpend   = (*(volatile UINT32 *)(UINTN)(0x0F310200));
+  Ract    = (*(volatile UINT32 *)(UINTN)(0x0F310300));
+  Rprio7  = (*(volatile UINT32 *)(UINTN)(0x0F310400 + 28));
+
+  DEBUG ((DEBUG_ERROR, "DG state EL=%lu DAIF=%lx SCTLR=%lx VBAR=%lx TCR=%lx MAIR=%lx\n", El, Daif, Sctlr, Vbar, Tcr, Mair));
+  DEBUG ((DEBUG_ERROR, "DG timer CNTFRQ=%lu CNTKCTL=%lx CNTP_CTL=%lx CNTP_CVAL=%lx CNTPCT=%lx\n", Frq, Kctl, PCtl, PCval, PCt));
+  DEBUG ((DEBUG_ERROR, "DG gic ICC_PMR=%lx IGRPEN1=%lx SRE=%lx GICD_CTLR=%x GICR_WAKER=%x ISEN0=%x ISPEND0=%x ISACT0=%x PRIO30=%x\n", Pmr, Grp1, Sre, Dctl, Rwake, Ren, Rpend, Ract, Rprio7));
+
+  //
+  // Prueba del contador de ciclos del PMU, igual que lo configura bootmgr (PMCCNTR_EL0).
+  //
+  {
+    UINT64  Pmcr, T0, A, B, Tn;
+
+    DEBUG ((DEBUG_ERROR, "DG pmu: leyendo PMCR_EL0\n"));
+    __asm__ volatile ("mrs %0, PMCR_EL0" : "=r" (Pmcr));
+    DEBUG ((DEBUG_ERROR, "DG pmu: PMCR_EL0=%lx (N=%lu E=%lu)\n", Pmcr, (Pmcr >> 11) & 0x1F, Pmcr & 1));
+    Tn = Pmcr | 0x10;
+    if ((Tn & 1) == 0) {
+      Tn |= 5;
+      __asm__ volatile ("msr PMCNTENCLR_EL0, %0; isb" : : "r" (0xFFFFFFFFULL));
+      __asm__ volatile ("msr PMOVSCLR_EL0, %0; isb" : : "r" (0xFFFFFFFFULL));
+      __asm__ volatile ("msr PMINTENCLR_EL1, %0; isb" : : "r" (0xFFFFFFFFULL));
+    }
+
+    Tn &= ~0x20ULL;
+    DEBUG ((DEBUG_ERROR, "DG pmu: escribiendo PMCR_EL0=%lx\n", Tn));
+    __asm__ volatile ("msr PMCR_EL0, %0; isb" : : "r" (Tn));
+    __asm__ volatile ("msr PMCCFILTR_EL0, %0; isb" : : "r" (0x08000000ULL));
+    __asm__ volatile ("msr PMCNTENSET_EL0, %0; isb" : : "r" (0x80000000ULL));
+    __asm__ volatile ("msr PMUSERENR_EL0, %0; isb" : : "r" (0ULL));
+    __asm__ volatile ("mrs %0, PMCCNTR_EL0" : "=r" (A));
+    __asm__ volatile ("mrs %0, CNTPCT_EL0" : "=r" (T0));
+    do {
+      __asm__ volatile ("mrs %0, CNTPCT_EL0" : "=r" (Tn));
+    } while ((Tn - T0) < (Frq / 100));
+
+    __asm__ volatile ("mrs %0, PMCCNTR_EL0" : "=r" (B));
+    __asm__ volatile ("mrs %0, PMCR_EL0" : "=r" (Pmcr));
+    DEBUG ((DEBUG_ERROR, "DG pmu: PMCCNTR antes=%lx despues(10ms)=%lx delta=%lu PMCR=%lx\n", A, B, B - A, Pmcr));
+  }
+
+  //
+  // Particiones GPT tal como las ve la UEFI en este arranque (solo las que empiezan pasado 7 GiB), una vez.
+  // Despues espera 25 s para dar tiempo a fotografiar la pantalla antes de que bootmgr la borre.
+  //
+  {
+    STATIC BOOLEAN  DgPart = FALSE;
+    STATIC EFI_GUID DgPiGuid = { 0x8cf2f62c, 0xbc9b, 0x4821, { 0x80, 0x8d, 0xec, 0x9e, 0xc4, 0x21, 0xa1, 0xa0 } };
+    EFI_HANDLE      *Hb;
+    UINTN           Hn, Hi, Gpt;
+    UINT8           *Pi, *E;
+    UINT32          Ty, U[4], T[4];
+    UINT64          S, En;
+    EFI_STATUS      St2;
+
+    if (!DgPart) {
+      DgPart = TRUE;
+      Hb     = NULL;
+      Hn     = 0;
+      Gpt    = 0;
+      St2    = gBS->LocateHandleBuffer (ByProtocol, &DgPiGuid, NULL, &Hn, &Hb);
+      DEBUG ((DEBUG_ERROR, "DG part: %lu handles con PartitionInfo (%r)\n", (UINT64)Hn, St2));
+      if (!EFI_ERROR (St2)) {
+        for (Hi = 0; Hi < Hn; Hi++) {
+          if (EFI_ERROR (gBS->HandleProtocol (Hb[Hi], &DgPiGuid, (VOID **)&Pi))) {
+            continue;
+          }
+
+          CopyMem (&Ty, Pi + 4, 4);
+          if (Ty != 2) {
+            continue;
+          }
+
+          Gpt++;
+          E = Pi + 16;
+          CopyMem (&S, E + 32, 8);
+          CopyMem (&En, E + 40, 8);
+          if (S >= 0xE00000ULL) {
+            CopyMem (T, E, 16);
+            CopyMem (U, E + 16, 16);
+            DEBUG ((DEBUG_ERROR, "DG part %lx-%lx tipo=%08x-%08x uid=%08x-%08x-%08x-%08x\n", S, En, T[0], T[1], U[0], U[1], U[2], U[3]));
+          }
+        }
+      }
+
+      DEBUG ((DEBUG_ERROR, "DG part: %lu particiones GPT. Espero 25 s...\n", (UINT64)Gpt));
+      gBS->Stall (25000000);
+    }
+  }
+
+  if (!mDgInstalled) {
+    mDgInstalled         = TRUE;
+    mDgStall             = gBS->Stall;
+    mDgGetTime           = gDxeCoreRT->GetTime;
+    mDgWatchdog          = gBS->SetWatchdogTimer;
+    mDgMono              = gBS->GetNextMonotonicCount;
+    gBS->Stall                    = DgStall;
+    gBS->SetWatchdogTimer         = DgWatchdog;
+    gBS->GetNextMonotonicCount    = DgMono;
+    gDxeCoreRT->GetTime           = DgGetTime;
+    gBS->Hdr.CRC32 = 0;
+    gBS->CalculateCrc32 (gBS, gBS->Hdr.HeaderSize, &gBS->Hdr.CRC32);
+    gDxeCoreRT->Hdr.CRC32 = 0;
+    gBS->CalculateCrc32 (gDxeCoreRT, gDxeCoreRT->Hdr.HeaderSize, &gDxeCoreRT->Hdr.CRC32);
+  }
+}
+#endif
+
+
 /**
   Transfer control to a loaded image's entry point.
 
@@ -1742,6 +2247,12 @@ CoreStartImage (
     // Call the image's entry point
     //
     Image->Started = TRUE;
+#if defined (MDE_CPU_AARCH64)
+    if (Image->ImageContext.ImageType == EFI_IMAGE_SUBSYSTEM_EFI_APPLICATION) {
+      DgDump ();
+    }
+
+#endif
     Image->Status  = Image->EntryPoint (ImageHandle, Image->Info.SystemTable);
 
     //
