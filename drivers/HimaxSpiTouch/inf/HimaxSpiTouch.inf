; HimaxSpiTouch.inf — driver táctil Himax HX83102E por SPI (SM-T500 WoA).
; Driver KMDF HID source usando Virtual HID Framework (VHF).
; Vhf.sys debe estar en la pila del dispositivo como filtro inferior.

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %Prov%
CatalogFile = HimaxSpiTouch.cat
DriverVer   = 11/07/2026,0.0.0.1
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13   ; carpeta del driver

[SourceDisksNames]
1 = %Disk%

[SourceDisksFiles]
HimaxSpiTouch.sys = 1

[Manufacturer]
%Prov% = Std, NTarm64

[Std.NTarm64]
%DevDesc% = Touch_Inst, ACPI\HMXT8310   ; igual que el _HID del SSDT

[Touch_Inst.NT]
CopyFiles = Touch_Files

[Touch_Files]
HimaxSpiTouch.sys

[Touch_Inst.NT.HW]
AddReg = Touch_HW_AddReg, VHF_LowerFilter

[Touch_HW_AddReg]
; El .bin del firmware NO va en el paquete: se copia a mano a System32\drivers.
; Ruta del firmware que lee FwReadFileFromRegistry (clave de hardware).
HKR,,"FirmwarePath",0x00000000,"\SystemRoot\System32\drivers\Himax_firmware_lide_hsd.bin"

[VHF_LowerFilter]
HKR,,"LowerFilters",0x00010000,"vhf"

[Touch_Inst.NT.Services]
AddService = HimaxSpiTouch, 0x00000002, Touch_Service

[Touch_Service]
ServiceType   = 1   ; SERVICE_KERNEL_DRIVER
StartType     = 3   ; DEMAND_START al principio (no colgar el arranque)
ErrorControl  = 1
ServiceBinary = %13%\HimaxSpiTouch.sys

; --- KMDF ---
[Touch_Inst.NT.Wdf]
KmdfService = HimaxSpiTouch, Touch_wdfsect

[Touch_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
Prov    = "SM-T500 WoA"
DevDesc = "Himax HX83102E SPI Touch"
Disk    = "HimaxSpiTouch Installation Disk"
